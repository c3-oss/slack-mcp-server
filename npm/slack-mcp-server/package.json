    "url": "https://github.com/c3-oss/slack-mcp-server/issues"
  },
  "license": "MIT",
  "bin": {
    "slack-mcp-server": "bin/slack-mcp-server.js"
  },
  "files": [
    "bin/slack-mcp-server.js",
    "README.md",
    "LICENSE"
  ],
  "optionalDependencies": {
    "@c3-oss/slack-mcp-server-darwin-arm64": "0.0.0-dev",
    "@c3-oss/slack-mcp-server-darwin-amd64": "0.0.0-dev",
    "@c3-oss/slack-mcp-server-linux-amd64": "0.0.0-dev",
